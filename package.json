{
  "name": "gnps2-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -b && vite build",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate": "tsx server/db/migrate.ts",
    "test:backend": "vitest run server/backend.integration.test.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "argon2": "^0.45.1",
    "carbone": "^3.8.2",
    "cloudinary": "^2.11.0",
    "csv-parse": "^7.0.3",
    "docx": "^9.0.3",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.2.5",
    "framer-motion": "^11.11.11",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.8.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.6.2",
    "supertest": "^7.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
